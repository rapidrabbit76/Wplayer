<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the emulator's host (10.0.2.2), for serving a plugin index while testing.
     Release builds keep Android's default, which refuses cleartext. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
